# Copy to .env and fill in. Never commit .env.

# Shared secret the badge sends as X-Badge-Key. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
BADGE_API_KEY=change-me

# Bind address: use the host's LAN IP (e.g. 192.168.1.50) rather than 0.0.0.0 (NFR-4)
BIND_HOST=192.168.1.50
BIND_PORT=8000

VEHICLE_NAME=MG Windsor EV
TZ_NAME=Asia/Kolkata

# ---- Vehicle provider: mock | homeassistant | saic
VEHICLE_PROVIDER=mock
# mock only: auto | parked | charging | unlocked | lowbatt | lowtyre
MOCK_SCENARIO=auto

# 12V safeguard (only applies to providers that hit the car's cloud directly)
POLL_PARKED_MIN=45
POLL_CHARGING_MIN=15
# Home Assistant provider re-reads HA's cached state this often (HA owns the cloud cadence)
POLL_HA_MIN=2
# Mark data stale if the last successful vehicle reading is older than this
STALE_AFTER_MIN=105

# ---- Home Assistant (recommended). Long-lived token: HA profile -> Security.
HA_URL=http://192.168.1.50:8123
HA_TOKEN=
# Entity IDs from your MG integration (Developer tools -> States). Leave blank if not available.
HA_ENTITY_SOC=sensor.mg_windsor_soc
HA_ENTITY_RANGE=sensor.mg_windsor_range
HA_ENTITY_CHARGING=binary_sensor.mg_windsor_charging
HA_ENTITY_PLUGGED=binary_sensor.mg_windsor_charger_connected
HA_ENTITY_CHARGE_TIME=sensor.mg_windsor_remaining_charging_time
HA_ENTITY_LOCK=lock.mg_windsor_doors
HA_ENTITY_TYRE_FL=sensor.mg_windsor_front_left_tyre_pressure
HA_ENTITY_TYRE_FR=sensor.mg_windsor_front_right_tyre_pressure
HA_ENTITY_TYRE_RL=sensor.mg_windsor_rear_left_tyre_pressure
HA_ENTITY_TYRE_RR=sensor.mg_windsor_rear_right_tyre_pressure
HA_ENTITY_CABIN_TEMP=sensor.mg_windsor_interior_temperature

# ---- Direct SAIC iSMART cloud (EXPERIMENTAL for JSW MG India). Use the SECONDARY account.
MG_USER=
MG_PASS=
MG_VIN=
SAIC_PHONE_COUNTRY_CODE=+91
SAIC_BASE_URI=
SAIC_REGION=
SAIC_TENANT_ID=

# ---- Weather (Open-Meteo, no key) — Hadapsar
WEATHER_ENABLED=true
LOCATION_NAME=Pune
PUNE_LAT=18.5089
PUNE_LON=73.9259
WEATHER_MIN=30

# ---- Calendar (optional): Google Calendar -> Settings -> "Secret address in iCal format"
CALENDAR_ICS_URL=
CALENDAR_MIN=10
